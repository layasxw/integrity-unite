# ──────────────────────────────────────────
# App settings
# ──────────────────────────────────────────
APP_ENV=development
APP_NAME="Integrity Unite API"
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-strong-random-secret
DEBUG=true

# ──────────────────────────────────────────
# CORS — add your frontend URLs here
# ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ──────────────────────────────────────────
# Database (fill in when ready)
# ──────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/integrity_unite

# ──────────────────────────────────────────
# Google Sheets sync (fill in when ready)
# ──────────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json
# VOLUNTEER_SHEET_ID=
# BRANCH_SHEET_ID=
# PUBLICATION_SHEET_ID=
